# =============================================================================
# Dify Workflow API
# =============================================================================

# Dify ホストの base URL(末尾スラッシュは不要)
# セルフホスティング版: 自社ドメインを指定
# 例: https://dify.example.com
DIFY_BASE_URL=

# Dify アプリの API キー(app- で始まる文字列)
# Dify 管理画面 → アプリ → APIアクセス で取得
# 注意: OpenAI の sk- で始まるキーではない
DIFY_API_KEY=

# (任意) SSL CA バンドル/証明書のパス
# 社内CA署名のセルフホスティングDify等、独自証明書で接続する場合に指定。
# 値が空または未設定の場合は、システムデフォルトのCA(certifi)で検証する。
# プロジェクトでは certs/ ディレクトリに置くことを推奨(.gitignore済)。
# 例: certs/internal-ca.pem
DIFY_CA_BUNDLE=
